# Local by default. All models must already be pulled into the configured Ollama server.
AQS_OLLAMA_URL=http://127.0.0.1:11434
AQS_QDRANT_URL=http://127.0.0.1:6333
AQS_MODEL=qwen2.5:3b
AQS_EMBEDDING_MODEL=bge-m3
AQS_EMBEDDING_DIMENSIONS=1024
AQS_COLLECTION=lumenvale
AQS_TIMEOUT_S=90
AQS_TOP_K=4
AQS_SCORE_FLOOR=0.25
AQS_TEMPERATURE=0.2
# AQS_SEED=42
AQS_MAX_TOKENS=384
AQS_CHUNK_WORDS=150
AQS_OVERLAP_WORDS=20
AQS_HISTORY_TURNS=4
AQS_SESSION_TTL_S=1800
AQS_SESSION_CAPACITY=500
AQS_INPUT_GUARD=true
AQS_ALLOW_BASELINE=false
AQS_ALLOW_REMOTE=false
AQS_PROVIDER=ollama
# Hosted generation sends prompts and passages to the configured HTTPS endpoint.
# AQS_HOSTED_URL=
# AQS_HOSTED_KEY=
# AQS_USD_PER_MILLION_INPUT=
# AQS_USD_PER_MILLION_OUTPUT=
